<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'mind-upload-console-ui-title'}"
                      MinSize="560 340"
                      Resizable="False">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal" Margin="10 6 10 0" HorizontalExpand="True" VerticalExpand="True">
            <!-- Positronic brain -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="0 0 6 0">
                <Label Text="{Loc 'mind-upload-console-ui-positronic'}" StyleClasses="highlight" />
                <BoxContainer Orientation="Horizontal">
                    <PanelContainer StyleClasses="BackgroundPanelDark" VerticalAlignment="Top">
                        <SpriteView Name="PositronicView" SetSize="96 96" OverrideDirection="South" />
                    </PanelContainer>
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="8 0 0 0">
                        <Label Name="PositronicName" ClipText="True" HorizontalExpand="True" />
                        <RichTextLabel Name="PositronicStatus" HorizontalExpand="True" />
                        <Button Name="EjectPositronicButton" Text="{Loc 'mind-upload-console-ui-eject'}"
                                HorizontalAlignment="Left" Margin="0 6 0 0" />
                    </BoxContainer>
                </BoxContainer>
                <ProgressBar Name="UploadProgress" MinValue="0" MaxValue="1" SetHeight="25"
                             HorizontalExpand="True" Margin="0 8 0 0">
                    <Label Name="UploadProgressText" Margin="4 0" Text="0 %" />
                </ProgressBar>
            </BoxContainer>
            <!-- Source: brain or personal AI -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="6 0 0 0">
                <Label Text="{Loc 'mind-upload-console-ui-source'}" StyleClasses="highlight" />
                <BoxContainer Orientation="Horizontal">
                    <PanelContainer StyleClasses="BackgroundPanelDark" VerticalAlignment="Top">
                        <SpriteView Name="SourceView" SetSize="96 96" OverrideDirection="South" />
                    </PanelContainer>
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="8 0 0 0">
                        <Label Name="SourceName" ClipText="True" HorizontalExpand="True" />
                        <RichTextLabel Name="SourceStatus" HorizontalExpand="True" />
                        <Button Name="EjectSourceButton" Text="{Loc 'mind-upload-console-ui-eject'}"
                                HorizontalAlignment="Left" Margin="0 6 0 0" />
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
        <BoxContainer Orientation="Vertical" Margin="10 8 10 8" HorizontalAlignment="Center">
            <Button Name="UploadButton" Text="{Loc 'mind-upload-console-ui-upload'}"
                    MinSize="260 36" HorizontalAlignment="Center" />
            <RichTextLabel Name="ConsoleStatus" HorizontalAlignment="Center" Margin="0 4 0 0" />
        </BoxContainer>
        <!-- Footer -->
        <BoxContainer Orientation="Vertical">
            <controls:Separator StyleClasses="LowDivider" />
            <BoxContainer Orientation="Horizontal" Margin="10 2 5 0" VerticalAlignment="Bottom">
                <Label Text="{Loc 'mind-upload-console-ui-flavor-left'}" StyleClasses="WindowFooterText" />
                <Label Text="{Loc 'mind-upload-console-ui-flavor-right'}" StyleClasses="WindowFooterText"
                       HorizontalAlignment="Right" HorizontalExpand="True" Margin="0 0 5 0" />
                <TextureRect StyleClasses="NTLogoDark" Stretch="KeepAspectCentered"
                             VerticalAlignment="Center" HorizontalAlignment="Right" SetSize="19 19" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
