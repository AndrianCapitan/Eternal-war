## Pressure: containers burst and get crushed, electronics break, wind throws things, the body suffers from pressure changes

pressure-material-glass = glass
pressure-material-thin-glass = thin glass
pressure-material-thin-metal = thin metal
pressure-material-metal = metal
pressure-material-plastic = plastic
pressure-material-cardboard = cardboard
pressure-material-electronics = electronics

pressure-break-burst = Bang! { CAPITALIZE(THE($item)) } bursts under pressure.
pressure-break-crushed = Crunch! { CAPITALIZE(THE($item)) } is crushed by pressure.
pressure-break-electronics = Crack! The electronics of { THE($item) } are crushed.

pressure-torn-examine-burst = [color=orange]Torn open by pressure from inside ({ $material }); it holds nothing any more.[/color]
pressure-torn-examine-crushed = [color=orange]Crushed by pressure from outside ({ $material }); it holds nothing any more.[/color]

pressure-wind-hit = The wind slams { THE($item) } into you!
pressure-wind-hit-others = The wind slams { THE($item) } into { THE($target) }!

broken-electronics-dead = { CAPITALIZE(THE($item)) } won't turn on: its electronics are broken.
broken-electronics-repaired = You fix the electronics of { THE($item) }.
broken-electronics-examine = [color=orange]Its electronics are broken; a screwdriver would fix them.[/color]

pressure-eardrum-burst = Something pops loudly in your ear: an eardrum burst!
pressure-lungs-torn = The air tears out of your chest, ripping your lungs!
pressure-decompression-bends = Your joints ache and your skin crawls: decompression sickness.
pressure-decompression-severe = Your sight darkens and your body goes numb: gas is boiling in your blood!
pressure-decompression-better = The numbness fades, but your joints still ache.
pressure-decompression-gone = The ache in your joints goes away.
