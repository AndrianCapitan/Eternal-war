# Name
loadout-name-edit-label = Задаёт имя, которое будет использоваться, если вы играете эту роль. Если пусто, будет использовано имя персонажа.
loadout-name-edit-label-dataset = Задаёт имя, которое будет использоваться, если вы играете эту роль. Если пусто, будет выбрано случайное имя.
loadout-name-edit-tooltip = Не более {$max} символов. Если имя не указано, может быть выбрано случайное.

# Restrictions
loadout-restrictions = Ограничения
loadouts-min-limit = Мин. количество: {$count}
loadouts-max-limit = Макс. количество: {$count}
loadouts-points-limit = Очки: {$count} / {$max}

loadouts-count-items-in-group = {$item} и ещё {$count} {$count ->
[one] предмет
[few] предмета
*[many] предметов
}

loadouts-points-restriction = Недостаточно очков
